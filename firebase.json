{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/click",
        "function": "clickHandler"
      },
      {
        "source": "/register",
        "destination": "/register/index.html"
      },
      {
        "source": "/register/**",
        "destination": "/register/index.html"
      },
      {
        "source": "/invite",
        "destination": "/register/index.html"
      },
      {
        "source": "/ref/**",
        "destination": "/register/index.html"
      },
      {
        "source": "/signup",
        "destination": "/register/index.html"
      },
      {
        "source": "/join",
        "destination": "/register/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}